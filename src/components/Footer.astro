---
import Container from "@components/Container.astro";
import { SITE, SOCIALS } from "@consts";
import BackToTop from "@components/BackToTop.astro";

const year = new Date().getFullYear();

const COLUMNS = [
  {
    heading: "Site",
    links: [
      { href: "/about/", label: "About" },
      { href: "/work/", label: "Work" },
      { href: "/journey/", label: "Journey" },
    ],
  },
  {
    heading: "Read",
    links: [
      { href: "/articles/", label: "Writing" },
      { href: "/speaking/", label: "Talks" },
      { href: "/topics/", label: "Topics" },
    ],
  },
];

const LINKEDIN = SOCIALS.find((social) => social.NAME === "linkedin")?.HREF;
const OTHER_SOCIALS = SOCIALS.filter((social) => social.NAME !== "linkedin");
---

<footer class="border-t border-subtle mt-16 sm:mt-24 pt-10">
  <Container>
    <div class="relative">
      <div class="absolute right-0 -top-24 sm:-top-28">
        <BackToTop />
      </div>
    </div>

    <div class="flex flex-wrap gap-x-12 gap-y-8">
      {
        COLUMNS.map((column) => (
          <nav aria-label={column.heading} class="min-w-[7rem]">
            <h2 class="font-mono text-xs uppercase tracking-[0.16em] text-meta">
              {column.heading}
            </h2>
            <ul class="mt-2">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="touch-target focus-ring text-sm text-prose hover:text-lime-600 dark:hover:text-lime-400 transition-colors duration-300"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="min-w-[10rem]">
        <h2 class="font-mono text-xs uppercase tracking-[0.16em] text-meta">
          Profiles
        </h2>
        <ul class="mt-2">
          {
            LINKEDIN && (
              <li>
                <a
                  href={LINKEDIN}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="touch-target focus-ring text-sm text-heading hover:text-lime-600 dark:hover:text-lime-400 transition-colors duration-300"
                >
                  LinkedIn &mdash; best way to reach me
                </a>
              </li>
            )
          }
          {
            OTHER_SOCIALS.map((social) => (
              <li>
                <a
                  href={social.HREF}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="touch-target focus-ring text-sm text-prose hover:text-lime-600 dark:hover:text-lime-400 transition-colors duration-300"
                >
                  {social.NAME === "github"
                    ? "GitHub"
                    : social.NAME === "stackoverflow"
                      ? "Stack Overflow"
                      : "Sessionize"}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/rss.xml"
              class="touch-target focus-ring text-sm text-prose hover:text-lime-600 dark:hover:text-lime-400 transition-colors duration-300"
            >
              RSS
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-5 border-t border-subtle font-mono text-xs text-meta">
      &copy; {year} {SITE.NAME}
    </div>
  </Container>
</footer>
