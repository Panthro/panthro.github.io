---
/**
 * Single cycling theme control: system → light → dark → system.
 *
 * The three per-mode buttons that `Head.astro` binds by id
 * (`light-theme-button`, `dark-theme-button`, `system-theme-button`) are kept
 * in the DOM but display:none. The visible button proxies a click to whichever
 * one matches the next mode, so all theme logic still lives in Head.astro and
 * nothing there needed to change. The visible button carries the active state:
 * its icon and label always describe the mode currently in effect.
 */
---

<div class="shrink-0 flex items-center">
  <button
    id="theme-cycle-button"
    type="button"
    aria-label="Theme: system. Change theme."
    data-theme-mode="system"
    class="group focus-ring size-11 -mr-2 flex items-center justify-center rounded-full text-zinc-500 dark:text-zinc-400 hover:text-lime-600 dark:hover:text-lime-400 transition-colors duration-300 ease-in-out"
  >
    <svg
      data-theme-icon="light"
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="hidden"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    </svg>
    <svg
      data-theme-icon="dark"
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="hidden"
      aria-hidden="true"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
    <svg
      data-theme-icon="system"
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
      <line x1="8" y1="21" x2="16" y2="21"></line>
      <line x1="12" y1="17" x2="12" y2="21"></line>
    </svg>
  </button>

  <button id="light-theme-button" hidden aria-hidden="true" tabindex="-1"></button>
  <button id="dark-theme-button" hidden aria-hidden="true" tabindex="-1"></button>
  <button id="system-theme-button" hidden aria-hidden="true" tabindex="-1"></button>
</div>

<script is:inline>
  (function () {
    var ORDER = ["system", "light", "dark"];
    var LABEL = { system: "system", light: "light", dark: "dark" };

    function currentMode() {
      var stored = localStorage.getItem("theme");
      return stored === "light" || stored === "dark" ? stored : "system";
    }

    function paint() {
      var button = document.getElementById("theme-cycle-button");
      if (!button) return;

      var mode = currentMode();
      button.setAttribute("data-theme-mode", mode);
      button.setAttribute(
        "aria-label",
        "Theme: " + LABEL[mode] + ". Change theme."
      );
      button.setAttribute("title", "Theme: " + LABEL[mode]);

      var icons = button.querySelectorAll("[data-theme-icon]");
      for (var i = 0; i < icons.length; i++) {
        icons[i].classList.toggle(
          "hidden",
          icons[i].getAttribute("data-theme-icon") !== mode
        );
      }

      button.onclick = function () {
        var next = ORDER[(ORDER.indexOf(currentMode()) + 1) % ORDER.length];
        var proxy = document.getElementById(next + "-theme-button");
        if (proxy) proxy.click();
        paint();
      };
    }

    paint();

    if (!window.__themeCycleBound) {
      window.__themeCycleBound = true;
      document.addEventListener("DOMContentLoaded", function () {
        paint();
      });
      document.addEventListener("astro:after-swap", function () {
        paint();
      });
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", function () {
          paint();
        });
    }
  })();
</script>
