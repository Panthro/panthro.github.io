---
import "../styles/global.css";
// Must be imported here, not from src/pages/journey/index.astro: CSS imported
// from a page's own frontmatter (or from a component only that page renders) is
// silently dropped from the production bundle in this Astro/Vite setup — it
// works in `astro dev` and is absent from `dist/`. All CSS ships as one bundle
// anyway, so the page-scoped import bought nothing.
import "../styles/journey.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/600.css";
import "@fontsource-variable/bricolage-grotesque";
// Only the two faces used above the fold are preloaded. Inter 600 and both
// JetBrains Mono weights are still imported as CSS above; preloading them too
// puts five high-priority font requests in front of LCP.
import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2";
import bgVariable from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2";

import { ClientRouter } from "astro:transitions";
import JsonLd from "@components/JsonLd.astro";
import { SITE } from "@consts";

type OgType = "website" | "article";

type ArticleMeta = {
  publishedTime: string;
  tags?: string[];
  author?: string;
};

interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: OgType;
  article?: ArticleMeta;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description,
  image,
  ogType = "website",
  article,
  jsonLd,
} = Astro.props;

const ogImagePath = image ?? SITE.OG_IMAGE;
const ogImage = new URL(ogImagePath, Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="light dark" />
<script is:inline>
  (function () {
    var theme = localStorage.getItem("theme");
    var dark =
      theme === "dark" ||
      (theme !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
    if (dark) document.documentElement.classList.add("dark");
  })();
</script>
<meta name="theme-color" content="#f4f4f5" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />

<!-- Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)">
<link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="msapplication-config" content="/browserconfig.xml" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads: only the two faces that render above the fold -->
<link rel="preload" href={bgVariable} as="font" type="font/woff2" crossorigin/>
<link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" type="application/rss+xml" title={`${SITE.NAME} — Writing`} href={new URL("/rss.xml", Astro.site)} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={SITE.NAME} />

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content={SITE.NAME} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{ogType === "article" && article && (
  <>
    <meta property="article:published_time" content={article.publishedTime} />
    {article.author && <meta property="article:author" content={article.author} />}
    {article.tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonLd && <JsonLd data={jsonLd} />}

<ClientRouter />

<script>
  import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
  document.addEventListener("astro:before-swap", (e) =>
    [
      ...(e as TransitionBeforeSwapEvent).newDocument.head.querySelectorAll(
        "link[as=\"font\"]"
      ),
    ].forEach((link) => link.remove())
  );
</script>

<script is:inline>
  var _scrollHandler = null;
  var _tocObserver = null;
  var _revealObserver = null;
  var _schemeWatcher = null;

  function init() {
    preloadTheme();
    onScroll();
    animateHero();
    initTocSpy();
    initArticleReveals();

    var backToTop = document.getElementById("back-to-top");
    backToTop && backToTop.addEventListener("click", function(event) { scrollToTop(event); });

    var lightThemeButton = document.getElementById("light-theme-button");
    lightThemeButton && lightThemeButton.addEventListener("click", function() {
      localStorage.setItem("theme", "light");
      toggleTheme(false);
    });

    var darkThemeButton = document.getElementById("dark-theme-button");
    darkThemeButton && darkThemeButton.addEventListener("click", function() {
      localStorage.setItem("theme", "dark");
      toggleTheme(true);
    });

    var systemThemeButton = document.getElementById("system-theme-button");
    systemThemeButton && systemThemeButton.addEventListener("click", function() {
      localStorage.setItem("theme", "system");
      toggleTheme(getPreferredDark());
    });

    // Registered once for the lifetime of the document. init() re-runs on every
    // astro:after-swap, and matchMedia() returns a fresh MediaQueryList each call,
    // so registering here would leak one live handler per client-side navigation.
    if (!_schemeWatcher) {
      _schemeWatcher = window.matchMedia("(prefers-color-scheme: dark)");
      _schemeWatcher.addEventListener("change", function(event) {
        var theme = localStorage.theme;
        if (!theme || theme === "system") {
          toggleTheme(event.matches);
        }
      });
    }

    if (_scrollHandler) {
      document.removeEventListener("scroll", _scrollHandler);
    }
    _scrollHandler = onScroll;
    document.addEventListener("scroll", _scrollHandler);
  }

  function animateHero() {
    var heroElements = document.querySelectorAll(".animate-hero");
    var reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    heroElements.forEach(function(element, index) {
      element.classList.remove("show");
      if (reducedMotion) {
        element.classList.add("show");
      } else {
        setTimeout(function() {
          element.classList.add("show");
        }, index * 100);
      }
    });
  }

  function initArticleReveals() {
    if (_revealObserver) {
      _revealObserver.disconnect();
      _revealObserver = null;
    }

    var reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var elements = document.querySelectorAll(".article-reveal");

    if (reducedMotion) {
      document.documentElement.classList.remove("reveal-ready");
      elements.forEach(function(element) {
        element.classList.add("show");
      });
      return;
    }

    document.documentElement.classList.add("reveal-ready");

    elements.forEach(function(element) {
      element.classList.remove("show");
    });

    _revealObserver = new IntersectionObserver(
      function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add("show");
            _revealObserver.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "0px 0px -6% 0px", threshold: 0.08 }
    );

    elements.forEach(function(element) {
      _revealObserver.observe(element);
    });

    // A scroll reveal is right for content you scroll into and wrong for content
    // you arrive at. Anything already at or above the fold on first paint — hash
    // jumps, restored scroll positions, short pages — is shown immediately and
    // without transition; only what is genuinely below the fold animates.
    revealAlreadyInView();
    window.addEventListener("load", revealAlreadyInView, { once: true });
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(revealAlreadyInView);
    }
  }

  function revealAlreadyInView() {
    if (!_revealObserver) return;

    var viewportHeight = window.innerHeight || document.documentElement.clientHeight;
    var settled = [];

    document.querySelectorAll(".article-reveal").forEach(function(element) {
      if (element.classList.contains("show")) return;
      if (element.getBoundingClientRect().top >= viewportHeight) return;

      element.style.transition = "none";
      element.classList.add("show");
      _revealObserver.unobserve(element);
      settled.push(element);
    });

    if (settled.length === 0) return;

    // Force the untransitioned state to paint before handing transitions back,
    // otherwise the restore lands in the same frame and the fade runs anyway.
    void document.documentElement.offsetHeight;
    requestAnimationFrame(function() {
      settled.forEach(function(element) {
        element.style.transition = "";
      });
    });
  }

  function initTocSpy() {
    if (_tocObserver) {
      _tocObserver.disconnect();
      _tocObserver = null;
    }

    var toc = document.querySelector("nav[aria-label=\"Table of contents\"]");
    if (!toc) return;

    var links = toc.querySelectorAll(".toc-link");
    if (links.length === 0) return;

    var headings = [];
    links.forEach(function(link) {
      var href = link.getAttribute("href");
      if (!href || href.charAt(0) !== "#") return;
      var heading = document.getElementById(href.slice(1));
      if (heading) headings.push(heading);
    });

    if (headings.length === 0) return;

    _tocObserver = new IntersectionObserver(
      function(entries) {
        var visible = entries
          .filter(function(entry) { return entry.isIntersecting; })
          .sort(function(a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; });

        if (visible.length === 0) return;

        var activeId = visible[0].target.id;
        links.forEach(function(link) {
          var isActive = link.getAttribute("href") === "#" + activeId;
          link.classList.toggle("toc-active", isActive);
          if (isActive) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      },
      { rootMargin: "-20% 0px -55% 0px", threshold: 0 }
    );

    headings.forEach(function(heading) {
      _tocObserver.observe(heading);
    });
  }

  function onScroll() {
    if (window.scrollY > 0) {
      document.documentElement.classList.add("scrolled");
    } else {
      document.documentElement.classList.remove("scrolled");
    }
  }

  function scrollToTop(event) {
    event.preventDefault();
    var reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    window.scrollTo({
      top: 0,
      behavior: reducedMotion ? "auto" : "smooth"
    });
  }

  function toggleTheme(dark) {
    var css = document.createElement("style");

    css.appendChild(
      document.createTextNode(
        "* {" +
        "  -webkit-transition: none !important;" +
        "  -moz-transition: none !important;" +
        "  -o-transition: none !important;" +
        "  -ms-transition: none !important;" +
        "  transition: none !important;" +
        "}"
      )
    );

    document.head.appendChild(css);

    if (dark) {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }

    window.getComputedStyle(css).opacity;
    document.head.removeChild(css);
  }

  function getPreferredDark() {
    var userTheme = localStorage.theme;
    if (userTheme === "light") return false;
    if (userTheme === "dark") return true;
    return window.matchMedia("(prefers-color-scheme: dark)").matches;
  }

  function preloadTheme() {
    toggleTheme(getPreferredDark());
  }

  document.addEventListener("DOMContentLoaded", function() { init(); });
  document.addEventListener("astro:after-swap", function() { init(); });
  preloadTheme();
</script>
